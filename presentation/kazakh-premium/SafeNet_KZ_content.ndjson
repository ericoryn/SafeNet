ition":{"left":474,"top":546,"width":320,"height":35},"style":{"fontSize":20,"typeface":"Arial","color":"#ADBDC7","alignment":"left"}},{"id":"sh/zip07qp0","position":{"left":828,"top":501,"width":4,"height":82}},{"id":"sh/kjyh0v6l","text":"Пирамида белгілері","position":{"left":848,"top":498,"width":320,"height":40},"style":{"fontSize":26,"typeface":"Arial","color":"#D8C3A1","bold":true,"alignment":"left"}},{"id":"sh/lk7i9076","text":"Түпнұсқа  →  Белгі  →  Тексеру","position":{"left":848,"top":546,"width":320,"height":35},"style":{"fontSize":20,"typeface":"Arial","color":"#ADBDC7","alignment":"left"}},{"id":"sh/mlgz25or","text":"Жүйе белгілерді анықтайды. Соңғы шешімді адам қабылдайды.","position":{"left":56,"top":658,"width":1120,"height":38},"style":{"fontSize":23,"typeface":"Arial","color":"#46DBC4","alignment":"left"}},{"id":"sh/76p0bapc","text":"01 / 08","position":{"left":1140,"top":36,"width":100,"height":30},"style":{"fontSize":16,"typeface":"Arial","color":"#ADBDC7","alignment":"left"}}],"notes":{"text":"0:00–0:30\nSafeNet KZ — цифрлық ортадағы күмәнді схемаларды анықтайтын платформа. Ол ақылы ұтыс ойындарын, онлайн-казиноның жасырын жарнамасын және қаржы пирамидаларының белгілерін бір жұмыс орнында талдауға көмектеседі. Платформа күмәнді материалды белгілейді, дәлелдерді жинақтайды және тексеру кезегін реттейді. Мақсат — аналитикке негізді шешім қабылдауға көмектесу. Соңғы шешімді әрдайым адам қабылдайды."}}
