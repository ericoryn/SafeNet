:"#ADBDC7","alignment":"left"}},{"id":"sh/i9cripgn","text":"Жалған дабыл үлесі","position":{"left":1007,"top":546,"width":222,"height":31},"style":{"fontSize":19,"typeface":"Arial","color":"#ADBDC7","alignment":"left"}},{"id":"sh/h83a9kf2","position":{"left":56,"top":578,"width":1168,"height":1}},{"id":"sh/w7u9gzyx","text":"Ақылы ұтыс","position":{"left":56,"top":579,"width":560,"height":33},"style":{"fontSize":23,"typeface":"Arial","color":"#8EBBEE","alignment":"left"}},{"id":"sh/pcj6lgvm","text":"84,6%","position":{"left":650,"top":579,"width":190,"height":33},"style":{"fontSize":23,"typeface":"Arial","color":"#F0F5F5","bold":true,"alignment":"left"}},{"id":"sh/4ba5cve1","text":"91,7%","position":{"left":830,"top":579,"width":190,"height":33},"style":{"fontSize":23,"typeface":"Arial","color":"#F0F5F5","bold":true,"alignment":"left"}},{"id":"sh/3a1ojqdg","text":"1,9%","position":{"left":1007,"top":579,"width":190,"height":33},"style":{"fontSize":23,"typeface":"Arial","color":"#F0F5F5","bold":true,"alignment":"left"}},{"id":"sh/i9snalwb","position":{"left":56,"top":609,"width":1168,"height":1}},{"id":"sh/h8j6hgvq","text":"Казино жарнамасы","position":{"left":56,"top":610,"width":560,"height":33},"style":{"fontSize":23,"typeface":"Arial","color":"#C3B0F4","alignment":"left"}},{"id":"sh/g7a58be5","text":"100,0%","position":{"left":650,"top":610,"width":190,"height":33},"style":{"fontSize":23,"typeface":"Arial","color":"#F0F5F5","bold":true,"alignment":"left"}},{"id":"sh/v61of6dk","text":"33,3%","position":{"left":830,"top":610,"width":190,"height":33},"style":{"fontSize":23,"typeface":"Arial","color":"#F0F5F5","bold":true,"alignment":"left"}},{"id":"sh/u5sn61wz","text":"0,0%","position":{"left":1007,"top":610,"width":190,"height":33},"style":{"fontSize":23,"typeface":"Arial","color":"#F0F5F5","bold":true,"alignment":"left"}},{"id":"sh/t4z6dwve","position":{"left":56,"top":640,"width":1168,"height":1}},{"id":"sh/83q54bet","text":"Пирамида белгілері","position":{"left":56,"top":641,"width":560,"height":33},"style":{"fontSize":23,"typeface":"Arial","color":"#D8C3A1","alignment":"left"}},{"id":"sh/y9o3excr","text":"82,4%","position":{"left":650,"top":641,"width":190,"height":33},"style":{"fontSize":23,"typeface":"Arial","color":"#F0F5F5","bold":true,"alignment":"left"}},{"id":"sh/jax4n2tc","text":"58,3%","position":{"left":830,"top":641,"width":190,"height":33},"style":{"fontSize":23,"typeface":"Arial","color":"#F0F5F5","bold":true,"alignment":"left"}},{"id":"sh/kb6lg7ux","text":"3,1%","position":{"left":1007,"top":641,"width":190,"height":33},"style":{"fontSize":23,"typeface":"Arial","color":"#F0F5F5","bold":true,"alignment":"left"}},{"id":"sh/lcfmpcbi","text":"Тәуелсіз бағалау емес. Нақты ортадағы сапаны растамайды.","position":{"left":56,"top":679,"width":1168,"height":32},"style":{"fontSize":20,"typeface":"Arial","color":"#46DBC4","alignment":"left"}}],"notes":{"text":"3:20–4:10\nНәтиже экранында тәуекел деңгейі, себептер, бастапқы үзінділер және тексеру күйі бірге көрінеді. Бұл — интерфейс макеті. Аналитик белгілерді растайды, жалған дабылды белгілейді немесе қосымша тексеру сұратады. Кестедегі сандар 240 синтетикалық материалды қайталап тексеруден алынған. Ұтыс ойындарында дәлдік 84,6%, толықтық 91,7%, жалған дабыл үлесі 1,9%. Казино бағытында — 100%, 33,3% және 0%; пирамида белгілерінде — 82,4%, 58,3% және 3,1%. Жалған дабыл үлесі теріс мысалдар бойынша есептеледі. Казиноның жоғары дәлдігі төмен толықтықты жасырмауы керек: оң мысалдардың үштен екісі анықталмай қалған. Бұл тәуелсіз бағалау емес және нақты ортадағы сапаны растамайды."}}
{"id":"sl/gl29w9","index":7,"elements":[{"id":"sh/cru98nqd","position":{"left":56,"top":45,"width":36,"height":4}},{"id":"sh/ds3a187y","text":"07  /  КЕЛЕСІ ҚАДАМДАР","position":{"left":108,"top":32,"width":950,"height":32},"style":{"fontSize":16,"typeface":"Arial","color":"#ADBDC7","alignment":"left"}},{"id":"sh/qpcr6d87","text":"08 / 08","position":{"left":1140,"top":28,"width":100,"height":30},"style":{"fontSize":16,"typeface":"Arial","color":"#ADBDC7","alignment":"left"}},{"id":"sh/rqlszips","text":"Дамыту жоспары","position":{"left":56,"top":84,"width":1168,"height":84},"style":{"fontSize":44,"typeface":"Arial","color":"#F0F5F5","bold":true,"alignment":"left"}},{"id":"sh/wnet476h","text":"Іске асқан негіз: үш бағыт, дәлелдер және аналитик шешімдерінің тарихы.","position":{"left":58,"top":166,"width":1160,"height":54},"style":{"fontSize":26,"typeface":"Arial","color":"#ADBDC7","alignment":"left"}},{"id":"sh/xo7adc72","position":{"left":56,"top":261,"width":368,"height":1}},{"id":"sh/543axcz6","text":"01","position":{"left":56,"top":279,"width":74,"height":44},"style":{"fontSize":30,"typeface":"Arial","color":"#46DBC4","alignment":"left"}},{"id":"sh/k3u9o7yl","text":"ЖОСПАР","position":{"left":146,"top":288,"width":200,"height":30},"style":{"fontSize":17,"typeface":"Arial","color":"#ADBDC7","alignment":"left"}},{"id":"sh/j21sv2h0","text":"Белгілерді\nнақтылау","position":{"left":56,"top":344,"width":368,"height":85},"style":{"fontSize":32,"typeface":"Arial","color":"#F0F5F5","bold":true,"alignment":"left"}},{"id":"sh/i1srmxgv","text":"Қазақша және аралас мәтін.\nЖалған дабыл себептері.","position":{"left":56,"top":450,"width":368,"height":82},"style":{"fontSize":24,"typeface":"Arial","color":"#ADBDC7","alignment":"left"}},{"id":"sh/x0jatsza","position":{"left":456,"top":261,"width":368,"height":1}},{"id":"sh/wza9knyp","text":"02","position":{"left":456,"top":279,"width":74,"height":44},"style":{"fontSize":30,"typeface":"Arial","color":"#46DBC4","alignment":"left"}},{"id":"sh/ve1sr2h4","text":"ЖОСПАР","position":{"left":546,"top":288,"width":200,"height":30},"style":{"fontSize":17,"typeface":"Arial","color":"#ADBDC7","alignment":"left"}},{"id":"sh/adsrixgj","text":"Тәуелсіз\nбағалау","position":{"left":456,"top":344,"width":368,"height":85},"style":{"fontSize":32,"typeface":"Arial","color":"#F0F5F5","bold":true,"alignment":"left"}},{"id":"sh/9cjapszy","text":"Жаңа деректер жиыны.\nҚателерді бөлек өлшеу.","position":{"left":456,"top":450,"width":368,"height":82},"style":{"fontSize":24,"typeface":"Arial","color":"#ADBDC7","alignment":"left"}},{"id":"sh/8bq9gnyd","position":{"left":856,"top":261,"width":368,"height":1}},{"id":"sh/yho7qtwb","text":"03","position":{"left":856,"top":279,"width":74,"height":44},"style":{"fontSize":30,"typeface":"Arial","color":"#46DBC4","alignment":"left"}},{"id":"sh/zixozyxw","text":"ЖОСПАР","position":{"left":946,"top":288,"width":200,"height":30},"style":{"fontSize":17,"typeface":"Arial","color":"#ADBDC7","alignment":"left"}},{"id":"sh/0j6psjeh","text":"Аналитикпен\nпилот","position":{"left":856,"top":344,"width":368,"height":85},"style":{"fontSize":32,"typeface":"Arial","color":"#F0F5F5","bold":true,"alignment":"left"}},{"id":"sh/lkz61of2","text":"Тексеру уақыты мен қателер.\nТүсіндірмелердің пайдасы.","position":{"left":856,"top":450,"width":368,"height":82},"style":{"fontSize":24,"typeface":"Arial","color":"#ADBDC7","alignment":"left"}},{"id":"sh/qdo7m9wf","position":{"left":56,"top":558,"width":1168,"height":1}},{"id":"sh/bexovex0","text":"Үш бағыт. Бір платформа.\nӘр белгіге — нақты дәлел","position":{"left":56,"top":583,"width":1168,"height":117},"style":{"fontSize":46,"typeface":"Arial","color":"#46DBC4","alignment":"left"}}],"notes":{"text":"4:10–4:40\nКелесі қадам — қазақша және аралас мәтіндегі күрделі белгілерді нақтылау. Содан кейін бұрын қолданылмаған материалдармен тәуелсіз бағалау өткізіп, әр бағыттың қателерін бөлек өлшейміз. Үшінші қадам — аналитиктермен шектеулі пилот: тексеруге кеткен уақытты, анықталмай қалған жағдайларды және түсіндірмелердің пайдасын бағалау. Бұл қадамдар — даму жоспары. Біздің ұстанымымыз өзгермейді: Үш бағыт. Бір платформа. Әр белгіге — нақты дәлел."}}